# Copie para .env e ajuste
PORT=3000
# Postgres local (ex.: docker run -e POSTGRES_PASSWORD=senha -p 5432:5432 postgres)
DATABASE_URL=postgres://postgres:senha@localhost:5432/agendafacil
# Em produção use um valor longo e aleatório
JWT_SECRET=troque-este-segredo
# Origens permitidas (separe por vírgula). Vazio = qualquer origem (só para desenvolvimento)
CORS_ORIGIN=http://localhost:5500
# Fuso usado para "hoje" e para esconder horários que já passaram
APP_TZ=America/Sao_Paulo
